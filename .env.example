# Copy this file to .env and fill in your own values. NEVER commit .env.
# No private keys are needed here: signing uses the key in your OS keychain
# (created when you ran `near create-account ... --useFaucet`).

# "mock" (default, nothing real moves), "near-testnet" (server checks rules, then pays),
# or "near-contract" (the SMART CONTRACT checks the rules and pays; see contract/ and README)
PAYMENT_MODE=mock

# Your TESTNET account that pays (not your mainnet .near account)
NEAR_ACCOUNT_ID=

# Which real testnet account receives each logical recipient from the policy.
# Format: logical=real,logical=real  (create these accounts with the same CLI command)
RECIPIENT_MAP=data-api.near=YOURNAME-data.testnet,research-agent.near=YOURNAME-research.testnet

# Demo amounts are scaled down: 5 "demo NEAR" -> 0.05 real testnet NEAR
PAYMENT_SCALE=0.01

# --- Optional: real LLM agent (OpenAI-compatible, e.g. NEAR AI Cloud) ---
# Leave LLM_API_KEY empty to use the built-in "naive rules" agent.
# Docs: https://docs.near.ai/cloud/guides/openai-compatibility
LLM_API_KEY=
LLM_BASE_URL=https://cloud-api.near.ai/v1
# Check which models your account can use: GET {LLM_BASE_URL}/models
LLM_MODEL=zai-org/GLM-5.1-FP8

# --- Optional: NEAR Intents cross-chain payout QUOTES (dry run only, nothing is sent) ---
# Intents has no testnet, so this app only asks for price quotes. Set both to enable the buttons.
# Account that would be refunded (your mainnet .near account), and a destination address on Base.
INTENTS_REFUND_TO=
INTENTS_RECIPIENT=
# INTENTS_DEST_SYMBOL=USDC
# INTENTS_DEST_CHAIN=base
# Optional JWT from the 1Click dashboard (removes the per-swap fee on live swaps; not needed for quotes)
# ONECLICK_JWT=

# --- Only for PAYMENT_MODE=near-contract ---
# The deployed Allowance contract, and the account that approves/rejects held payments.
# NEAR_ACCOUNT_ID (above) must be the AGENT account that the contract was initialised with.
CONTRACT_ID=
OWNER_ACCOUNT_ID=
# Optional: a separate GUARDIAN account. If an untrusted message makes the agent try a payment that is
# blocked, the guardian pauses the agent on-chain (it can only pause; only the owner can resume).
GUARDIAN_ACCOUNT_ID=
# Optional: NEAR RPC used to verify wallet-signed transactions and to read the contract's live state.
# NEAR_RPC_URL=https://rpc.testnet.near.org
